# APP_URL: The URL where this applet is addresses.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# EMAILJS CONFIGURATION: Configurer ces variables pour recevoir les e-mails réels du formulaire.
# Obtenez vos clés gratuites sur https://dashboard.emailjs.com/
VITE_EMAILJS_PUBLIC_KEY=""
VITE_EMAILJS_SERVICE_ID=""
VITE_EMAILJS_TEMPLATE_ID=""
